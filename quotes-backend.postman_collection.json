                                "type": "text/javascript",
                                "exec": [
                                    "pm.variables.set(\"longText\", \"ж\".repeat(1001));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                                    "const json = pm.response.json();",
                                    "pm.test(\"body has an errors object\", () => pm.expect(json.errors).to.be.an(\"object\"));",
                                    "pm.test(\"error is reported for `text`\", () => pm.expect(json.errors).to.have.property(\"text\"));"
                                ]
