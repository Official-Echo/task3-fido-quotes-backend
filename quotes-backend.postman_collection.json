                {
                    "name": "Create: author longer than 200",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/quotes",
                            "host": ["{{baseUrl}}"],
                            "path": ["quotes"]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"author\": \"{{longAuthor}}\",\n  \"text\": \"Чому мене ніхто не цитує в цитатах ФІ?\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.variables.set(\"longAuthor\", \"а\".repeat(201));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                                    "const json = pm.response.json();",
                                    "pm.test(\"body has an errors object\", () => pm.expect(json.errors).to.be.an(\"object\"));",
                                    "pm.test(\"error is reported for `author`\", () => pm.expect(json.errors).to.have.property(\"author\"));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Create: text longer than 1000",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
