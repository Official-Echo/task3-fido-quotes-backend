        {
            "name": "3. Cleanup",
            "item": [
                {
                    "name": "Delete quote",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/quotes/{{quoteId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["quotes", "{{quoteId}}"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));",
                                    "pm.test(\"body is empty\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get deleted quote",
                    "request": {
                        "method": "GET",
                        "header": [],
